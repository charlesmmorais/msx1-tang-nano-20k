// =============================================================================
// Constraints de pinagem — Tang Nano 20K (Gowin GW2AR-18C)
// MSX1 FPGA
// =============================================================================

// Clock principal (27 MHz onboard crystal)
IO_LOC "sys_clk" 4;
IO_PORT "sys_clk" IO_TYPE=LVCMOS33;

// Botão reset (S1 — ativo baixo)
IO_LOC "sys_rst_n" T2;
IO_PORT "sys_rst_n" IO_TYPE=LVCMOS18, PULL_MODE=UP;

// Botões auxiliares
IO_LOC "btn1" T3;
IO_PORT "btn1" IO_TYPE=LVCMOS18, PULL_MODE=UP;
IO_LOC "btn2" T2;
IO_PORT "btn2" IO_TYPE=LVCMOS18, PULL_MODE=UP;

// LEDs (ativo baixo)
IO_LOC "led[0]" L3;
IO_PORT "led[0]" IO_TYPE=LVCMOS18, DRIVE=8;
IO_LOC "led[1]" L4;
IO_PORT "led[1]" IO_TYPE=LVCMOS18, DRIVE=8;

// ---------------------------------------------------------------------------
// HDMI (conector onboard)
// TMDS diferenciado — usar ELVDS_OBUF + OSER10
// ---------------------------------------------------------------------------
IO_LOC "tmds_clk_p" H5;
IO_LOC "tmds_clk_n" G5;
IO_PORT "tmds_clk_p" IO_TYPE=LVCMOS33D, PULL_MODE=NONE, DRIVE=8;
IO_PORT "tmds_clk_n" IO_TYPE=LVCMOS33D, PULL_MODE=NONE, DRIVE=8;

IO_LOC "tmds_d0_p" J3;
IO_LOC "tmds_d0_n" J4;
IO_PORT "tmds_d0_p" IO_TYPE=LVCMOS33D, PULL_MODE=NONE, DRIVE=8;
IO_PORT "tmds_d0_n" IO_TYPE=LVCMOS33D, PULL_MODE=NONE, DRIVE=8;

IO_LOC "tmds_d1_p" H4;
IO_LOC "tmds_d1_n" H3;
IO_PORT "tmds_d1_p" IO_TYPE=LVCMOS33D, PULL_MODE=NONE, DRIVE=8;
IO_PORT "tmds_d1_n" IO_TYPE=LVCMOS33D, PULL_MODE=NONE, DRIVE=8;

IO_LOC "tmds_d2_p" F5;
IO_LOC "tmds_d2_n" E5;
IO_PORT "tmds_d2_p" IO_TYPE=LVCMOS33D, PULL_MODE=NONE, DRIVE=8;
IO_PORT "tmds_d2_n" IO_TYPE=LVCMOS33D, PULL_MODE=NONE, DRIVE=8;

// ---------------------------------------------------------------------------
// SD Card (slot onboard)
// ---------------------------------------------------------------------------
IO_LOC "sd_clk"  D8;
IO_PORT "sd_clk" IO_TYPE=LVCMOS33, DRIVE=8, PULL_MODE=NONE;

IO_LOC "sd_mosi" B11;
IO_PORT "sd_mosi" IO_TYPE=LVCMOS33, DRIVE=8, PULL_MODE=NONE;

IO_LOC "sd_miso" A11;
IO_PORT "sd_miso" IO_TYPE=LVCMOS33, PULL_MODE=UP;

IO_LOC "sd_cs_n" B12;
IO_PORT "sd_cs_n" IO_TYPE=LVCMOS33, DRIVE=8, PULL_MODE=NONE;

// ---------------------------------------------------------------------------
// Teclado PS/2 (PMOD 1 — conector esquerdo)
// Pin 1 (GPIO38) = PS2_CLK
// Pin 2 (GPIO39) = PS2_DAT
// ---------------------------------------------------------------------------
IO_LOC "ps2_clk" M11;
IO_PORT "ps2_clk" IO_TYPE=LVCMOS33, PULL_MODE=UP;

IO_LOC "ps2_dat" N11;
IO_PORT "ps2_dat" IO_TYPE=LVCMOS33, PULL_MODE=UP;

// ---------------------------------------------------------------------------
// Saída de áudio PDM (PMOD 1, pino 3)
// ---------------------------------------------------------------------------
IO_LOC "audio_pdm" M10;
IO_PORT "audio_pdm" IO_TYPE=LVCMOS33, DRIVE=8;

